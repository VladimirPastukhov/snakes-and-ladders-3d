{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snakes-and-ladders-3d",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Existing files are served directly; every other request reaches the Worker,
  // which decides between the game page (deep links) and a 404.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    // Overridden by CI with the deployed commit SHA: wrangler deploy --var VERSION:<sha>
    "VERSION": "dev",
  },
  // One Durable Object per Match (ADR 0001). It owns the seats and every socket of that Match.
  "durable_objects": {
    "bindings": [{ "name": "MATCH", "class_name": "Match" }],
  },
  // Once deployed, a migration can't be undone: roll forward, never back past it.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Match"] }],
  "observability": {
    "enabled": true,
  },
}
